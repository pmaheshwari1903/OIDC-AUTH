{
    "version": 2,
    "builds": [
        {
            "src": "src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/css/(.*)",
            "dest": "/src/public/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/src/public/js/$1"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/src/public/assets/$1"
        },
        {
            "src": "/(.*)",
            "dest": "src/index.ts"
        }
    ]
}
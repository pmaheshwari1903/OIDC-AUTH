{
    "version": 2,
    "builds": [
        {
            "src": "src/index.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": "public/**"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/src/index.ts"
        }
    ]
}